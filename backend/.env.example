# Copy to .env for local development. Never commit .env.

# Leave unset to use the embedded database in .data/pglite.
# DATABASE_URL=postgres://nyaya:nyaya@localhost:5432/nyaya

# Required in production. In development a random one is made per start.
# JWT_SECRET=

PORT=3000
CORS_ORIGINS=http://localhost:3001
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30
AUTH_RATE_LIMIT_PER_MINUTE=10

# Dev only: `npm run seed` creates admin@, editor@, reviewer@ and publisher@nyaya.local
# with this password. Pick your own.
SEED_PASSWORD=

# Dev only: publish the imported starter questions without review, so the app
# has content locally. Refused in production.
# SEED_PUBLISH_IMPORTED=true

# Ask AI (POST /v1/chat). Chat is unavailable when the endpoint or key is unset.
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5.4-mini
# CHAT_DAILY_LIMIT=50
# CHAT_FREE_DAILY_LIMIT=5

# Testing only: let the app turn premium on (no payment). Off by default and in
# the beta: demo premium then counts for nothing and cannot be turned on.
# DEMO_PREMIUM=true

# Oldest app version still allowed, like 0.2.0. Older builds show an "update the
# app" screen. Leave unset to block none. APP_UPDATE_URL is the store page that
# screen opens (https only).
# MIN_APP_VERSION=
# APP_UPDATE_URL=
